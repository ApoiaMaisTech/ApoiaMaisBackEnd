DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
JWT_SECRET_KEY=your_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# /docs, /redoc e /openapi.json: deixe false fora do desenvolvimento
ENABLE_DOCS=false
LOG_LEVEL=INFO
LOG_JSON=true

# Redis (rate limit; travas e orçamento do go-worker). Senha obrigatória no compose.
REDIS_PASSWORD=your_redis_password
REDIS_URL=redis://:your_redis_password@redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_USER_CREATION=20/minute
RATE_LIMIT_AI_IMAGE=30/minute
SQL_ECHO=false

# RabbitMQ (use senha sem caracteres especiais de URL: @ : / ? #)
RABBITMQ_DEFAULT_USER=apoiamais
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_URL=amqp://apoiamais:your_rabbitmq_password@rabbitmq:5672/

# Mídia: local (volume) em dev; s3 em produção (S3, MinIO ou compatível)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/media
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Ilustrações por IA
AI_IMAGE_DAILY_QUOTA_PER_USER=20
AI_IMAGE_FAILURE_COOLDOWN_MINUTES=10
# go-worker: fake (sem custo, padrão) ou openai
AI_PROVIDER=fake
AI_IMAGE_MODEL=gpt-image-1
OPENAI_API_KEY=
AI_DAILY_IMAGE_BUDGET=200
WORKER_CONCURRENCY=4
