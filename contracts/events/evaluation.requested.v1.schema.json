{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evaluation.requested v1 (API -> rust-evaluator)",
  "description": "Pedido de avaliação de uma atividade. Só respostas e gabarito: nenhum dado que identifique a criança (nome, paciente, diagnóstico).",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_id", "items"],
  "properties": {
    "evaluation_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "kind", "answer", "expected"],
      "properties": {
        "item_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "kind": {"type": "string", "enum": ["text", "choice", "number"]},
        "answer": {
          "description": "text e number: exatamente 1 elemento; choice: as opções marcadas (pode ser vazio)",
          "type": "array",
          "maxItems": 50,
          "items": {"type": "string", "maxLength": 500}
        },
        "expected": {
          "description": "text e number: respostas aceitas (qualquer uma vale); choice: o conjunto de opções corretas",
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"type": "string", "maxLength": 500}
        },
        "ignore_case": {"type": "boolean", "default": true},
        "ignore_accents": {"type": "boolean", "default": false},
        "max_typos": {"type": "integer", "minimum": 0, "maximum": 3, "default": 0},
        "tolerance": {"type": "number", "minimum": 0, "default": 0}
      }
    }
  }
}
